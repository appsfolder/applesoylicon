# Maintainer: appsfolder <axelix@ass.engineering>
pkgname=applesoylicon
pkgver=1.1.0
pkgrel=1
pkgdesc='Playful Matrix-rain terminal screensaver'
arch=('x86_64' 'aarch64')
url='https://github.com/appsfolder/applesoylicon'
license=('MIT')
makedepends=('cargo')
depends=('glibc' 'coreutils')
optdepends=('iio-sensor-proxy: automatic rain direction from device orientation')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('3022b9a0aeb49c956bae877c6c2f8841950cfff43612bacc1c830a1b1206959a')

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
